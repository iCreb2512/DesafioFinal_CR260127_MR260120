    // Registra un nuevo libro en el arreglo
    static void RegistrarLibro()
    {
        // Evita pasar el límite del arreglo
        if (totalLibros >= 10)
        {
            Console.WriteLine("✘ Capacidad máxima de libros alcanzada (10).");
            return;
        }

        Console.WriteLine("\n--- REGISTRAR NUEVO LIBRO ---");
        Libro nuevoLibro = new Libro();

        // Validación del código: debe ser único y tener 8 caracteres
        bool codigoValido = false;
        while (!codigoValido)
        {
            Console.Write("Código (8 caracteres alfanuméricos, ej. LIB00001): ");
            nuevoLibro.codigo = (Console.ReadLine() ?? "").Trim().ToUpper();

            if (nuevoLibro.codigo.Length != 8)
            {
                Console.WriteLine("✘ El código debe tener exactamente 8 caracteres.");
            }
            else if (BuscarIndicePorCodigo(nuevoLibro.codigo) != -1)
            {
                Console.WriteLine("✘ Ya existe un libro con ese código.");
            }
            else
            {
                codigoValido = true;
            }
        }

        // Lectura de datos obligatorios
        nuevoLibro.titulo = LeerCampoObligatorio("Título: ");
        nuevoLibro.autor = LeerCampoObligatorio("Autor: ");
        nuevoLibro.editorial = LeerCampoObligatorio("Editorial: ");
        nuevoLibro.anioPublicacion = LeerEnteroEnRango("Año de publicación: ", 1900, DateTime.Now.Year);
        nuevoLibro.categoria = LeerCampoObligatorio("Categoría: ");
        nuevoLibro.ejemplaresDisponibles = LeerEnteroPositivo("Cantidad de ejemplares: ");

        // Guardar el libro en el arreglo
        libros[totalLibros] = nuevoLibro;
        totalLibros++;

        Console.WriteLine($"✔ Libro '{nuevoLibro.titulo}' registrado exitosamente.");
    }

    // Busca un libro por su código y devuelve la posición en el arreglo
    static int BuscarIndicePorCodigo(string codigo)
    {
        for (int i = 0; i < totalLibros; i++)
        {
            if (libros[i].codigo == codigo)
            {
                return i;
            }
        }
        return -1; // No encontrado
    }

    // Pide un texto que no puede ir vacío
    static string LeerCampoObligatorio(string mensaje)
    {
        string valor;
        do
        {
            Console.Write(mensaje);
            valor = (Console.ReadLine() ?? "").Trim();

            if (string.IsNullOrWhiteSpace(valor))
            {
                Console.WriteLine("✘ Este campo no puede estar vacío.");
            }
        } while (string.IsNullOrWhiteSpace(valor));

        return valor;
    }

    // Lee un número entero dentro de un rango permitido
    static int LeerEnteroEnRango(string mensaje, int minimo, int maximo)
    {
        int valor;
        bool valido = false;

        do
        {
            Console.Write(mensaje);
            valido = int.TryParse(Console.ReadLine(), out valor);

            if (!valido || valor < minimo || valor > maximo)
            {
                Console.WriteLine($"✘ Ingrese un número entre {minimo} y {maximo}.");
                valido = false;
            }
        } while (!valido);

        return valor;
    }

    // Lee un entero positivo o cero
    static int LeerEnteroPositivo(string mensaje)
    {
        int valor;
        bool valido = false;

        do
        {
            Console.Write(mensaje);
            valido = int.TryParse(Console.ReadLine(), out valor);

            if (!valido || valor < 0)
            {
                Console.WriteLine("✘ Ingrese un número válido mayor o igual a 0.");
                valido = false;
            }
        } while (!valido);

        return valor;
    }

