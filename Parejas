    // Registrar un nuevo usuario con validaciones
    static void RegistrarUsuario()
    {
        if (totalUsuarios >= 5)
        {
            Console.WriteLine("✘ Capacidad máxima de usuarios alcanzada (5).");
            return;
        }

        Console.WriteLine("\n--- REGISTRAR NUEVO USUARIO ---");
        Usuario nuevoUsuario = new Usuario();

        // Validar carné: exactamente 8 dígitos numéricos
        bool carneValido = false;
        while (!carneValido)
        {
            Console.Write("Carné (8 dígitos numéricos): ");
            nuevoUsuario.carne = Console.ReadLine().Trim();

            if (nuevoUsuario.carne.Length != 8)
            {
                Console.WriteLine("✘ El carné debe tener exactamente 8 dígitos.");
            }
            else
            {
                // Verificar que todos los caracteres sean dígitos
                bool esTodoNumero = true;

                // FOR: revisar carácter por carácter
                for (int i = 0; i < nuevoUsuario.carne.Length; i++)
                {
                    if (!char.IsDigit(nuevoUsuario.carne[i]))
                    {
                        esTodoNumero = false;
                        break;
                    }
                }

                if (!esTodoNumero)
                {
                    Console.WriteLine("✘ El carné solo debe contener dígitos numéricos.");
                }
                else if (BuscarIndiceUsuarioPorCarne(nuevoUsuario.carne) != -1)
                {
                    Console.WriteLine("✘ Ya existe un usuario con ese carné.");
                }
                else
                {
                    carneValido = true;
                }
            }
        }

        nuevoUsuario.nombre = LeerCampoObligatorio("Nombre completo: ");
        nuevoUsuario.carrera = LeerCampoObligatorio("Carrera: ");

        // Validar correo: debe contener '@' y punto después del '@'
        bool correoValido = false;
        while (!correoValido)
        {
            Console.Write("Correo electrónico: ");
            nuevoUsuario.correo = Console.ReadLine().Trim();

            int posArroba = nuevoUsuario.correo.IndexOf('@');

            // IF-ELSE: verificar formato del correo
            if (posArroba == -1)
            {
                Console.WriteLine("✘ El correo debe contener '@'.");
            }
            else if (nuevoUsuario.correo.IndexOf('.', posArroba) == -1)
            {
                Console.WriteLine("✘ El correo debe tener un punto después del '@'.");
            }
            else
            {
                correoValido = true;
            }
        }

        nuevoUsuario.telefono = LeerCampoObligatorio("Teléfono: ");
        nuevoUsuario.estado = "activo"; // Por defecto, los usuarios nuevos están activos

        usuarios[totalUsuarios] = nuevoUsuario;
        totalUsuarios++;

        Console.WriteLine($"✔ Usuario '{nuevoUsuario.nombre}' registrado exitosamente.");
    }

    // Buscar usuario por carné
    static void BuscarUsuarioPorCarne()
    {
        Console.Write("\nIngrese el carné del usuario: ");
        string carne = Console.ReadLine().Trim();

        int indice = BuscarIndiceUsuarioPorCarne(carne);

        if (indice != -1)
        {
            MostrarDatosUsuario(usuarios[indice]);
        }
        else
        {
            Console.WriteLine("✘ No se encontró ningún usuario con ese carné.");
        }
    }

    // Buscar usuario por nombre (búsqueda parcial, no distingue mayúsculas)
    static void BuscarUsuarioPorNombre()
    {
        Console.Write("\nIngrese el nombre o parte del nombre: ");
        string busqueda = Console.ReadLine().Trim().ToLower();

        bool encontrado = false;

        // FOR: recorrer todos los usuarios
        for (int i = 0; i < totalUsuarios; i++)
        {
            // Contains: verificar si el nombre del usuario contiene el texto buscado
            if (usuarios[i].nombre.ToLower().Contains(busqueda))
            {
                MostrarDatosUsuario(usuarios[i]);
                encontrado = true;
            }
        }

        if (!encontrado)
        {
            Console.WriteLine("✘ No se encontraron usuarios con ese nombre.");
        }
    }

    // Listar todos los usuarios
    static void ListarUsuarios()
    {
        if (totalUsuarios == 0)
        {
            Console.WriteLine("✘ No hay usuarios registrados.");
            return;
        }

        Console.WriteLine("\n--- LISTADO DE USUARIOS ---");

        for (int i = 0; i < totalUsuarios; i++)
        {
            Console.WriteLine($"\n[{i + 1}]");
            MostrarDatosUsuario(usuarios[i]);
        }
    }

    // Retorna el índice del usuario en el arreglo, o -1 si no existe
    static int BuscarIndiceUsuarioPorCarne(string carne)
    {
        for (int i = 0; i < totalUsuarios; i++)
        {
            if (usuarios[i].carne == carne)
                return i;
        }
        return -1;
    }

    // Mostrar todos los datos de un usuario
    static void MostrarDatosUsuario(Usuario u)
    {
        Console.WriteLine($"  Carné       : {u.carne}");
        Console.WriteLine($"  Nombre      : {u.nombre}");
        Console.WriteLine($"  Carrera     : {u.carrera}");
        Console.WriteLine($"  Correo      : {u.correo}");
        Console.WriteLine($"  Teléfono    : {u.telefono}");
        Console.WriteLine($"  Estado      : {u.estado}");
    }

    // Cargar libros desde libros.csv
    static void CargarLibros()
    {
        if (!File.Exists(rutaLibros)) return; // Si no existe el archivo, no cargar nada

        try
        {
            StreamReader lector = new StreamReader(rutaLibros);
            string linea;

            // WHILE: leer línea por línea hasta el final del archivo
            while ((linea = lector.ReadLine()) != null && totalLibros < 10)
            {
                string[] partes = linea.Split(',');

                // Verificar que la línea tiene todos los campos (7 campos)
                if (partes.Length == 7)
                {
                    libros[totalLibros].codigo = partes[0];
                    libros[totalLibros].titulo = partes[1];
                    libros[totalLibros].autor = partes[2];
                    libros[totalLibros].editorial = partes[3];
                    libros[totalLibros].anioPublicacion = int.Parse(partes[4]);
                    libros[totalLibros].categoria = partes[5];
                    libros[totalLibros].ejemplaresDisponibles = int.Parse(partes[6]);
                    totalLibros++;
                }
            }

            lector.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"✘ Error al cargar libros: {ex.Message}");
        }
    }
    // Cargar usuarios desde usuarios.txt
    static void CargarUsuarios()
    {
        if (!File.Exists(rutaUsuarios)) return;

        try
        {
            StreamReader lector = new StreamReader(rutaUsuarios);
            string linea;

            while ((linea = lector.ReadLine()) != null && totalUsuarios < 5)
            {
                string[] partes = linea.Split('|');

                if (partes.Length == 6)
                {
                    usuarios[totalUsuarios].carne = partes[0];
                    usuarios[totalUsuarios].nombre = partes[1];
                    usuarios[totalUsuarios].carrera = partes[2];
                    usuarios[totalUsuarios].correo = partes[3];
                    usuarios[totalUsuarios].telefono = partes[4];
                    usuarios[totalUsuarios].estado = partes[5];
                    totalUsuarios++;
                }
            }

            lector.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"✘ Error al cargar usuarios: {ex.Message}");
        }
    }

