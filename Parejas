using System;
using System.IO;

struct Libro
{
    public string codigo;
    public string titulo;
    public string autor;
    public string editorial;
    public int anioPublicacion;
    public string categoria;
    public int ejemplaresDisponibles;
}

struct Usuario
{
    public string carne;
    public string nombre;
    public string carrera;
    public string correo;
    public string telefono;
    public string estado;
}

struct Prestamo
{
    public string codigoPrestamo;
    public string carneUsuario;
    public string codigoLibro;
    public string fechaPrestamo;
    public string fechaDevolucion;
    public string estadoPrestamo;
}

class Program
{
    static Libro[] libros = new Libro[10];
    static Usuario[] usuarios = new Usuario[5];
    static Prestamo[] prestamos = new Prestamo[10];

    static int totalLibros = 0;
    static int totalUsuarios = 0;
    static int totalPrestamos = 0;

    static string rutaLibros = "Data/libros.csv";
    static string rutaUsuarios = "Data/usuarios.txt";
    static string rutaPrestamos = "Data/prestamos.txt";

    static void Main(string[] args)
    {
        if (!Directory.Exists("Data"))
        {
            Directory.CreateDirectory("Data");
        }

        CargarLibros();
        CargarUsuarios();
        CargarPrestamos();

        bool salir = false;

        do
        {
            MostrarMenuPrincipal();
            string opcion = Console.ReadLine() ?? "";

            switch (opcion)
            {
                case "1": MenuGestionLibros(); break;
                case "2": MenuGestionUsuarios(); break;
                case "3": MenuGestionPrestamos(); break;
                case "4":
                    GuardarLibros();
                    GuardarUsuarios();
                    GuardarPrestamos();
                    Console.WriteLine("\n✔ Datos guardados correctamente. ¡Hasta luego!");
                    salir = true;
                    break;
                default:
                    Console.WriteLine("\n✘ Opción inválida.");
                    break;
            }

        } while (!salir);
    }

    static void MostrarMenuPrincipal()
    {
        Console.WriteLine("\n╔══════════════════════════════════════════╗");
        Console.WriteLine("║   BIBLIOTECA UNIVERSITARIA - MENÚ PRINCIPAL  ║");
        Console.WriteLine("╠══════════════════════════════════════════╣");
        Console.WriteLine("║  1. Gestión de Libros                    ║");
        Console.WriteLine("║  2. Gestión de Usuarios                  ║");
        Console.WriteLine("║  3. Gestión de Préstamos                 ║");
        Console.WriteLine("║  4. Salir del Sistema                    ║");
        Console.WriteLine("╚══════════════════════════════════════════╝");
        Console.Write("Seleccione una opción: ");
    }

    static void MenuGestionLibros()
    {
        bool volver = false;

        do
        {
            Console.WriteLine("\n--- GESTIÓN DE LIBROS ---");
            Console.WriteLine("1. Registrar nuevo libro");
            Console.WriteLine("2. Buscar libro por código");
            Console.WriteLine("3. Listar todos los libros");
            Console.WriteLine("4. Eliminar libro");
            Console.WriteLine("5. Volver al menú principal");
            Console.Write("Opción: ");

            string opcion = Console.ReadLine() ?? "";

            switch (opcion)
            {
                case "1": RegistrarLibro(); break;
                case "2": BuscarLibroPorCodigo(); break;
                case "3": ListarLibros(); break;
                case "4": EliminarLibro(); break;
                case "5": volver = true; break;
                default: Console.WriteLine("✘ Opción inválida."); break;
            }

        } while (!volver);
    }

    static void RegistrarLibro()
    {
        if (totalLibros >= 10)
        {
            Console.WriteLine("✘ Capacidad máxima de libros alcanzada (10).");
            return;
        }

        Console.WriteLine("\n--- REGISTRAR NUEVO LIBRO ---");
        Libro nuevoLibro = new Libro();

        bool codigoValido = false;
        while (!codigoValido)
        {
            Console.Write("Código (8 caracteres): ");
            nuevoLibro.codigo = (Console.ReadLine() ?? "").Trim().ToUpper();

            if (nuevoLibro.codigo.Length != 8)
                Console.WriteLine("✘ El código debe tener 8 caracteres.");
            else if (BuscarIndicePorCodigo(nuevoLibro.codigo) != -1)
                Console.WriteLine("✘ Código ya existente.");
            else
                codigoValido = true;
        }

        nuevoLibro.titulo = LeerCampoObligatorio("Título: ");
        nuevoLibro.autor = LeerCampoObligatorio("Autor: ");
        nuevoLibro.editorial = LeerCampoObligatorio("Editorial: ");
        nuevoLibro.anioPublicacion = LeerEnteroEnRango("Año: ", 1900, DateTime.Now.Year);
        nuevoLibro.categoria = LeerCampoObligatorio("Categoría: ");
        nuevoLibro.ejemplaresDisponibles = LeerEnteroPositivo("Ejemplares: ");

        libros[totalLibros++] = nuevoLibro;

        Console.WriteLine($"✔ Libro '{nuevoLibro.titulo}' registrado.");
    }

    static int BuscarIndicePorCodigo(string codigo)
    {
        for (int i = 0; i < totalLibros; i++)
        {
            if (libros[i].codigo == codigo)
                return i;
        }
        return -1;
    }

    static void BuscarLibroPorCodigo()
    {
        Console.Write("\nIngrese el código del libro: ");
        string codigo = Console.ReadLine().Trim().ToUpper();

        int indice = BuscarIndicePorCodigo(codigo);

        if (indice != -1)
            MostrarDatosLibro(libros[indice]);
        else
            Console.WriteLine("✘ No encontrado.");
    }

    static void ListarLibros()
    {
        if (totalLibros == 0)
        {
            Console.WriteLine("✘ No hay libros.");
            return;
        }

        for (int i = 0; i < totalLibros; i++)
        {
            Console.WriteLine($"\n[{i + 1}]");
            MostrarDatosLibro(libros[i]);
        }
    }

    static void EliminarLibro()
    {
        Console.Write("\nCódigo a eliminar: ");
        string codigo = Console.ReadLine().Trim().ToUpper();

        int indice = BuscarIndicePorCodigo(codigo);

        if (indice == -1)
        {
            Console.WriteLine("✘ No encontrado.");
            return;
        }

        for (int i = indice; i < totalLibros - 1; i++)
        {
            libros[i] = libros[i + 1];
        }

        totalLibros--;
        Console.WriteLine("✔ Libro eliminado.");
    }

    static void MostrarDatosLibro(Libro l)
    {
        Console.WriteLine($"Código: {l.codigo}");
        Console.WriteLine($"Título: {l.titulo}");
        Console.WriteLine($"Autor: {l.autor}");
        Console.WriteLine($"Editorial: {l.editorial}");
        Console.WriteLine($"Año: {l.anioPublicacion}");
        Console.WriteLine($"Categoría: {l.categoria}");
        Console.WriteLine($"Ejemplares: {l.ejemplaresDisponibles}");
    }

    static string LeerCampoObligatorio(string mensaje)
    {
        string valor;
        do
        {
            Console.Write(mensaje);
            valor = (Console.ReadLine() ?? "").Trim();
        } while (string.IsNullOrWhiteSpace(valor));
        return valor;
    }

    static int LeerEnteroEnRango(string mensaje, int min, int max)
    {
        int valor;
        while (!int.TryParse(Console.ReadLine(), out valor) || valor < min || valor > max)
        {
            Console.Write($"Ingrese un valor entre {min} y {max}: ");
        }
        return valor;
    }

    static int LeerEnteroPositivo(string mensaje)
    {
        int valor;
        while (!int.TryParse(Console.ReadLine(), out valor) || valor < 0)
        {
            Console.Write("Ingrese un número válido: ");
        }
        return valor;
    }

    static void CargarLibros() { }
    static void CargarUsuarios() { }
    static void CargarPrestamos() { }

    static void GuardarLibros() { }
    static void GuardarUsuarios() { }
    static void GuardarPrestamos() { }

    static void MenuGestionUsuarios()
    {
        Console.WriteLine("Gestión de Usuarios...");
    }

    static void MenuGestionPrestamos()
    {
        Console.WriteLine("Gestión de Préstamos...");
    }
}